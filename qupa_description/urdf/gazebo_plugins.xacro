<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="$(arg tf_prefix)">

  <!--
    gazebo_plugins.xacro
    Gazebo Harmonic (gz-sim) plugin definitions for the QUPA robot.
    Only included when use_sim_plugins:=true (i.e. when spawning in Gazebo).
    Desktop / hardware launches should keep use_sim_plugins:=false.
  -->

  <xacro:if value="${use_sim_plugins}">

    <!-- ───────────────────────────────────────────────────────────────
         JOINT STATE PUBLISHER  (gz::sim::systems::JointStatePublisher)
         Publishes wheel joint positions to gz-transport so the
         ros_gz_bridge can forward them to ROS /joint_states and
         robot_state_publisher can compute the wheel TF frames.
    ─────────────────────────────────────────────────────────────────── -->
    <gazebo>
      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher">
        <topic>/$(arg tf_prefix)/joint_states</topic>
        <joint_name>L_wheel_joint</joint_name>
        <joint_name>R_wheel_joint</joint_name>
      </plugin>
    </gazebo>

    <!-- ───────────────────────────────────────────────────────────────
         DIFFERENTIAL DRIVE  (gz::sim::systems::DiffDrive)
         Publishes:  /{tf_prefix}/odom   (gz topic → ros_gz_bridge)
                     /tf                 (gz topic → ros_gz_bridge)
         Subscribes: /{tf_prefix}/cmd_vel (ros_gz_bridge → gz topic)
    ─────────────────────────────────────────────────────────────────── -->
    <gazebo>
      <plugin filename="gz-sim-diff-drive-system"
              name="gz::sim::systems::DiffDrive">
        <left_joint>L_wheel_joint</left_joint>
        <right_joint>R_wheel_joint</right_joint>
        <wheel_separation>0.088</wheel_separation>
        <wheel_radius>0.016</wheel_radius>
        <!-- velocity / acceleration limits matching the real robot -->
        <max_velocity>0.08</max_velocity>
        <max_angular_velocity>2.5</max_angular_velocity>
        <max_linear_acceleration>0.1</max_linear_acceleration>
        <max_angular_acceleration>10.0</max_angular_acceleration>
        <!-- gz-transport topic names (bridged to ROS by ros_gz_bridge) -->
        <topic>/$(arg tf_prefix)/cmd_vel</topic>
        <odom_topic>/$(arg tf_prefix)/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
        <!-- TF frame names -->
        <frame_id>$(arg tf_prefix)/odom</frame_id>
        <child_frame_id>$(arg tf_prefix)/base_link</child_frame_id>
        <odom_publish_frequency>40</odom_publish_frequency>
      </plugin>
    </gazebo>

  </xacro:if>

</robot>
