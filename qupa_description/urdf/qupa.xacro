<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="$(arg tf_prefix)">

    <xacro:property name="M_PI" value="3.1415926535897931" />
    <xacro:property name="tf_prefix"       value="$(arg tf_prefix)"/>
    <xacro:property name="high_res"        value="$(arg high_res)"        lazy_eval="false"/>
    <xacro:property name="module"          value="$(arg module)"          lazy_eval="false"/>
    <xacro:property name="use_sim_plugins" value="$(arg use_sim_plugins)" lazy_eval="false"/>
    <xacro:property name="base_height" value="0.0" />
    <xacro:property name="mirror_height" value="${base_height + 0.2}" />
    <!-- IR ring inset: <1 pulls the IR sensors radially INWARD (more recessed
         into the body). 1.0 = original edge position; 0.82 ≈ 1 cm inward. -->
    <xacro:property name="ir_inset_scale" value="0.82" />
    <!--Include Xacro files -->
    <xacro:include filename="$(find qupa_description)/urdf/wheels/wheel.xacro" />                   <!--wheel properties and links definitions-->
    <xacro:include filename="$(find qupa_description)/urdf/sensors/infrared.xacro" />               <!--infrared sensor properties and links definitions-->
    <xacro:include filename="$(find qupa_description)/urdf/sensors/mirror.xacro" />                 <!--logical camera properties and links definitions, the mirror acts as a 'camera'-->
    <xacro:include filename="$(find qupa_description)/urdf/bases/module.xacro" />      
    <xacro:include filename="$(find qupa_description)/urdf/bases/base.xacro" />                     <!--base properties and links definitions-->
    <xacro:include filename="$(find qupa_description)/urdf/gazebo_plugins.xacro" />                 <!--Gazebo plugins definitions--> 
    <xacro:include filename="$(find qupa_description)/urdf/sensors/color.xacro" />
    <xacro:include filename="$(find qupa_description)/urdf/sensors/led.xacro" />
    <xacro:include filename="$(find qupa_description)/urdf/wheels/caster.xacro" />
    
    <material name="dark">
        <color rgba="0.3 0.3 0.3 1.0"/>
    </material>
    <material name="light_black">
        <color rgba="0.4 0.4 0.4 1.0"/>
    </material>
    <material name="gray">
        <color rgba="0.4 0.4 0.4 1.0"/>
    </material>

    <!--Base Macro-->
    <xacro:if value="${module}">
        <!--Xacro properties changes-->
        <xacro:property name="base_height" value="0.04" />

        <xacro:module/>               <!--Module Base-->

        <!--Links-->
        <xacro:link_1
            prefix="Left"
            parent_link="${tf_prefix}/base_link"
            xyz="0.042536 0.012084 0.0782"
            rpy="0 0 0.55"/>
        <xacro:link_1
            prefix="Right"
            parent_link="${tf_prefix}/base_link"
            xyz="0.042536 -0.012116 0.0782"
            rpy="0 0 -0.43481"/>
        <xacro:link_2 
            xyz="0.030029 -1.8353E-05 0.0055"
            rpy="0 0 -0.82341"/>
        <xacro:link_3 
            xyz="0.030031 1.4561E-05 0.0035"
            rpy="0 0 0.76626"/>
        <xacro:EE/>

        <!--Transmissions-->
        <xacro:transmission_effort  name="trans_motor_left_link_1" 
                                    joint_name="Left_joint_1"
                                    actuator_name="left_motor"/>

        <xacro:transmission_effort  name="trans_motor_right_link_1" 
                                    joint_name="Right_joint_1"
                                    actuator_name="right_motor"/>

        <xacro:transmission_passive name="left_link_1_left_link_2" 
                                    joint_name="Left_joint_2"
                                    actuator_name="left_1to2"/>

        <xacro:transmission_passive name="right_link_1_right_link_2" 
                                    joint_name="Right_joint_2"
                                    actuator_name="right_1to2"/>

        <xacro:transmission_effort  name="end_effector_motor" 
                                    joint_name="EE_joint"
                                    actuator_name="ee_motor"/>
        
        <!--plugin-->
        <gazebo>
            <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
                <robotNamespace>$(arg tf_prefix)</robotNamespace>
                <robotSimType>gazebo_ros_control/ClosedLoopHWSim</robotSimType>
            </plugin>
        </gazebo>    

    </xacro:if>

    <xacro:unless value="${module}">
        <xacro:base/>                   <!--Normal Base-->
    </xacro:unless>
    <xacro:mirror/>                     <!--Mirror Macro-->

    <!-- Wheels Macro-->
    <xacro:wheel
        wheel_name="${tf_prefix}/R_wheel"
        wheel_joint_name="R_wheel_joint"
        wheel_parent_name="${tf_prefix}/base_link"
        wheel_joint_origin_xyz="-0 0.0415 0.016"
        wheel_joint_origin_rpy=" 1.5708 0 3.1416" />
    <xacro:wheel
        wheel_name="${tf_prefix}/L_wheel"
        wheel_joint_name="L_wheel_joint"
        wheel_parent_name="${tf_prefix}/base_link"
        wheel_joint_origin_xyz="0 -0.0415 0.016"
        wheel_joint_origin_rpy=" 1.5708 0 0" />
    <xacro:caster
        link_name = "${tf_prefix}/caster_R"
        joint_name = "caster_R_joint"
        joint_origin_xyz = "0.0305 -0.0265 0.005"/>
    <xacro:caster
        link_name = "${tf_prefix}/caster_L"
        joint_name = "caster_L_joint"
        joint_origin_xyz = "0.0305 0.0265 0.005"/>
    <xacro:caster
        link_name = "${tf_prefix}/caster_B"
        joint_name = "caster_B_joint"
        joint_origin_xyz = "-0.0325 0 0.005"/>
    
    
 
    <xacro:infrared 
        joint_origin_xyz="0.00 0 0.034"
        joint_origin_rpy="1.5708 0 0" />

    <xacro:ir_sensor link_name="ir_0"
        joint_name="ir_0_joint"
        joint_origin_xyz="${0.004*ir_inset_scale} ${-0.056*ir_inset_scale} 0.034"
        joint_origin_rpy="${M_PI/2} 0 0" />

    <xacro:ir_sensor link_name="ir_45"
        joint_name="ir_45_joint"
        joint_origin_xyz="${0.04159*ir_inset_scale} ${-0.0376*ir_inset_scale} 0.034"
        joint_origin_rpy="${M_PI/2} 0 ${M_PI/4}" />

    <xacro:ir_sensor link_name="ir_90"
        joint_name="ir_90_joint"
        joint_origin_xyz="${0.056*ir_inset_scale} 0 0.034"
        joint_origin_rpy="${M_PI/2} 0 ${M_PI/2}" />

    <xacro:ir_sensor link_name="ir_135"
        joint_name="ir_135_joint"
        joint_origin_xyz="${0.04159*ir_inset_scale} ${0.0376*ir_inset_scale} 0.034"
        joint_origin_rpy="${M_PI/2} 0 ${3*M_PI/4}" />

    <xacro:ir_sensor link_name="ir_180"
        joint_name="ir_180_joint"
        joint_origin_xyz="${0.004*ir_inset_scale} ${0.056*ir_inset_scale} 0.034"
        joint_origin_rpy="${M_PI/2} 0 ${M_PI}" />

    <xacro:ir_sensor link_name="ir_270"
        joint_name="ir_270_joint"
        joint_origin_xyz="${-0.056*ir_inset_scale} 0 0.034"
        joint_origin_rpy="${M_PI/2} 0 ${-M_PI/2}" />




    <!-- Floor colour sensor — always present regardless of camera mode -->
    <xacro:color_camera/>

    <!-- LED ring — 5 point lights on the dome -->
    <xacro:led_ring/>

    <xacro:if value="${high_res}">
        <xacro:real_cam/>
    </xacro:if>
    <xacro:unless value="${high_res}">
        <xacro:log_cam/>            <!--Logical Camera Macro-->
    </xacro:unless>

  </robot>
