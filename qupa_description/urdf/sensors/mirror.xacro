<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="$(arg tf_prefix)">

    <xacro:property name="camera_height" value="0.18" />

    <!-- ─────────────────────────────────────────────────────────────────
         MIRROR — physical mesh (always present, no sensor)
    ───────────────────────────────────────────────────────────────────── -->
    <xacro:macro name="mirror">
        <link name="$(arg tf_prefix)/mirror_link">
            <inertial>
                <origin xyz="0 0.0072703 1.0408E-17" rpy="0 0 0" />
                <mass value="0.00099484" />
                <inertia ixx="5.9879E-08" ixy="4.6719E-24" ixz="2.2618E-23"
                         iyy="1.0131E-07" iyz="-1.9251E-23" izz="5.9879E-08" />
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="package://qupa_description/meshes/mirror.stl" />
                </geometry>
                <material name="">
                    <color rgba="0.74902 0.74902 0.74902 1" />
                </material>
            </visual>
        </link>

        <joint name="mirror_joint" type="fixed">
            <origin xyz="0 0 ${mirror_height}" rpy="1.5708 0 0" />
            <parent link="$(arg tf_prefix)/base_link" />
            <child link="$(arg tf_prefix)/mirror_link" />
            <axis xyz="1 0 0" />
        </joint>
    </xacro:macro>

    <!-- ─────────────────────────────────────────────────────────────────
         LOGICAL CAMERA  (high_res:=false)
         Cone-shaped sensor from the mirror point of reference.
         Simulates the conical FOV that the hyperbolic mirror provides.
         No rendering required — works without GPU.
    ───────────────────────────────────────────────────────────────────── -->
    <xacro:macro name="log_cam">
        <link name="$(arg tf_prefix)/logical_camera_link">
            <inertial>
                <mass value="0.001" />
                <origin xyz="0 0 0" rpy="0 0 0" />
                <inertia ixx="1.875e-8" ixy="0.0" ixz="0.0"
                         iyy="1.875e-8" iyz="0.0" izz="1.25e-8" />
            </inertial>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry><cylinder radius="0.005" length="0.01"/></geometry>
            </collision>
        </link>

        <joint name="logical_camera_joint" type="fixed">
            <parent link="$(arg tf_prefix)/base_link" />
            <child link="$(arg tf_prefix)/logical_camera_link" />
            <origin xyz="0 0 ${camera_height}" rpy="0 1.5708 0" />
        </joint>

        <!-- Gazebo Harmonic: logical_camera sensor (no rendering, no GPU needed) -->
        <xacro:if value="${use_sim_plugins}">
            <gazebo reference="$(arg tf_prefix)/logical_camera_link">
                <sensor name="$(arg tf_prefix)_mirror" type="logical_camera">
                    <logical_camera>
                        <near>0.04</near>
                        <far>0.20</far>
                        <horizontal_fov>2.5</horizontal_fov>
                        <aspect_ratio>1.0</aspect_ratio>
                    </logical_camera>
                    <visualize>false</visualize>
                    <always_on>true</always_on>
                    <update_rate>20</update_rate>
                    <topic>/$(arg tf_prefix)/logical_camera</topic>
                </sensor>
            </gazebo>
        </xacro:if>
    </xacro:macro>

    <!-- ─────────────────────────────────────────────────────────────────
         FISHEYE CAMERA  (high_res:=true)
         Wide-angle camera that replicates the hyperbolic mirror + camera
         setup of the real robot. Uses Gazebo Harmonic's wideanglecamera
         sensor with a custom lens function (tan projection, 360° FOV).

         Requires: gz-sim-sensors-system with ogre2 render engine.
         The raw image is published on gz-transport only — no ROS image
         topic is created. The camera_sim_node reads it via gz-transport
         Python and publishes only camera/detections (DetectionArray).
    ───────────────────────────────────────────────────────────────────── -->
    <xacro:macro name="real_cam">
        <link name="$(arg tf_prefix)/camera_link">
            <inertial>
                <mass value="0.001" />
                <origin xyz="0 0 0" rpy="0 0 0" />
                <inertia ixx="1.875e-8" ixy="0.0" ixz="0.0"
                         iyy="1.875e-8" iyz="0.0" izz="1.25e-8" />
            </inertial>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry><cylinder radius="0.005" length="0.01"/></geometry>
            </collision>
        </link>

        <!--
            Joint at camera_height (0.20 m) pointing upward toward the mirror.
            rpy="0 1.5708 0" rotates the link so the camera faces the mirror.
        -->
        <joint name="camera_joint" type="fixed">
            <parent link="$(arg tf_prefix)/base_link" />
            <child link="$(arg tf_prefix)/camera_link" />
            <origin xyz="0 0 ${camera_height}" rpy="0 1.5708 0" />
        </joint>

        <!-- Gazebo Harmonic: wideanglecamera sensor (requires ogre2 rendering) -->
        <xacro:if value="${use_sim_plugins}">
            <gazebo reference="$(arg tf_prefix)/camera_link">
                <sensor name="$(arg tf_prefix)_camera" type="wideanglecamera">
                    <camera>
                        <!-- 360° horizontal FOV — full surround view like the mirror -->
                        <!-- SDF max is 2π = 6.28318…; 6.2832 exceeds it by rounding -->
                        <horizontal_fov>6.28318</horizontal_fov>
                        <image>
                            <width>640</width>
                            <height>480</height>
                            <format>R8G8B8</format>
                        </image>
                        <clip>
                            <near>0.05</near>
                            <far>5.0</far>
                        </clip>
                        <!--
                            Custom fisheye lens — replicates the tan-projection
                            that the hyperbolic mirror introduces.
                            r(θ) = c1 * tan(c2 * θ + f)
                        -->
                        <lens>
                            <type>custom</type>
                            <custom_function>
                                <!--
                                    FÓRMULA REAL del shader (wide_lens_map_fp.glsl):
                                      r = c1 * f * fun(theta / c2)
                                    c2 DIVIDE theta (no multiplica).
                                    Con scale_to_hfov=true y hfov=360°, Gazebo ignora c1 y f
                                    y calcula f_eff = 1/fun(180°/c2).

                                    Con fun=sin, c2=2:
                                      f_eff = 1/sin(90°) = 1.0  →  sin monótona en [0°,180°] ✓
                                      θ=  0° → r = 0.000  (centro)
                                      θ= 90° → r = sin(45°) = 0.707  (horizonte al 70.7 %)
                                      θ=101° → r = sin(50.5°) = 0.771  (corte al 77.1 %)
                                      θ=180° → r = 1.000  (punto de normalización)

                                    | anterior: c1=1.05 c2=3.0 f=1.0 fun=tan cutoff=2.5
                                -->
                                <c1>1.0</c1>
                                <c2>2.0</c2>    <!-- theta/c2=theta/2: sin monótona hasta 180° -->
                                <f>1.0</f>      <!-- ignorado por scale_to_hfov=true -->
                                <fun>sin</fun>
                            </custom_function>
                            <scale_to_hfov>true</scale_to_hfov>
                            <!-- cutoff = 101° = φ_max del espejo real | anterior: 2.5 rad -->
                            <cutoff_angle>1.763</cutoff_angle>
                            <env_texture_size>512</env_texture_size>
                        </lens>
                    </camera>
                    <always_on>true</always_on>
                    <update_rate>5</update_rate>  <!-- real node runs at 3 Hz; 10 Hz gives margin -->
                    <!-- gz-transport topic consumed by camera_sim_node via gz-transport Python -->
                    <topic>/$(arg tf_prefix)/camera/image_raw</topic>
                </sensor>
            </gazebo>
        </xacro:if>
    </xacro:macro>

</robot>
