<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="$(arg tf_prefix)">

  <!--
    color.xacro — Downward-facing floor colour sensor.
    Physical sensor: TCS34725 (I2C) on the real robot.
    Simulation:      32×32 camera pointing down at 5 Hz (sensor rate).
                     Colour classification is done by floor_sensor_sim_node at 1 Hz.
  -->

  <xacro:macro name="color_camera">

    <link name="$(arg tf_prefix)/color_camera_link">
      <!-- Intentionally massless / collision-less — visual sensor only -->
    </link>

    <joint name="color_camera_joint" type="fixed">
      <origin xyz="-0.043 0 0.009" rpy="0 0 0" />
      <parent link="$(arg tf_prefix)/base_link" />
      <child  link="$(arg tf_prefix)/color_camera_link" />
      <axis   xyz="0 0 1" />
    </joint>

    <!-- Gazebo Harmonic: downward-facing camera + LED light (simulation only) -->
    <xacro:if value="${use_sim_plugins}">
      <gazebo reference="$(arg tf_prefix)/color_camera_link">

        <!--
          Simulated LED — replicates the TCS34725 integrated white LED.
          A small point light attached to the sensor link guarantees
          consistent, shadow-free illumination of the floor patch directly
          below the robot, independent of world lighting and robot body shadows.
          This also makes the sensor compatible with textured floor materials.
        -->
        <light name="$(arg tf_prefix)_floor_led" type="point">
          <pose>0 0 0 0 0 0</pose>
          <diffuse>1.0 1.0 1.0 1</diffuse>     <!-- white, neutral -->
          <specular>0.0 0.0 0.0 1</specular>    <!-- no specular — avoid reflections -->
          <attenuation>
            <range>0.12</range>       <!-- 12 cm — only illuminates the floor patch -->
            <constant>0.8</constant>
            <linear>0.2</linear>
            <quadratic>0.05</quadratic>
          </attenuation>
          <cast_shadows>false</cast_shadows>    <!-- no shadows from such a close light -->
        </light>

        <!--
          Camera sensor — looks straight down (-Z world).
          In Gazebo Harmonic the camera looks along its local +X axis.
          Pitch +π/2 rotates +X → -Z (downward).
        -->
        <sensor name="$(arg tf_prefix)_floor_camera" type="camera">
          <pose>0 0 0 0 1.5708 0</pose>
          <camera>
            <horizontal_fov>1.0</horizontal_fov>
            <image>
              <width>4</width>
              <height>4</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.005</near>
              <far>0.15</far>
            </clip>
          </camera>
          <always_on>true</always_on>
          <update_rate>5</update_rate>
          <topic>/$(arg tf_prefix)/floor_camera/image_raw</topic>
        </sensor>

      </gazebo>
    </xacro:if>

  </xacro:macro>

</robot>
