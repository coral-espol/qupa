<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="base_mass" value="1" />
    <xacro:property name="base_scale" value="1 1 1" />

    <!-- Real robot is white -->
    <material name="white">
        <color rgba="1.0 1.0 1.0 1.0" />
    </material>

    <!-- Acrylic dome: WHITE translucent diffuser the LEDs glow through.
         acrylic_alpha: 0 = invisible, 1 = fully opaque. Lower = lighter/clearer. -->
    <xacro:property name="acrylic_alpha" value="0.98" />
    <material name="acrylic">
        <color rgba="1.0 1.0 1.0 ${acrylic_alpha}" />
    </material>

    <xacro:macro name="base">
    
        <!-- <link name="base_footprint"/>

        <joint name="base_joint" type="fixed">
            <parent link="base_footprint"/>
            <child link="base_link"/>
            <origin xyz="0.0 0.0 -0.0" rpy="0 0 0"/>
        </joint> -->

        <link name="$(arg tf_prefix)/base_link">
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <mass value="${base_mass}" />
                <inertia
                    ixx="0.01423"
                    ixy="0"
                    ixz="0"
                    iyy="0.01423"
                    iyz="0"
                    izz="0.00180" />
                </inertial>
            <!-- Body shell (opaque). The acrylic dome lives on its OWN link
                 (acrylic_dome_link, below) so led_sim_node can drive its
                 emissive colour by a clean, stable visual name. -->
            <visual name="base_body">
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="package://qupa_description/meshes/base.stl" scale="${base_scale}" />
                </geometry>
                <material name="white" />
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="package://qupa_description/meshes/base.stl" scale="${base_scale}" />
                </geometry>
                <self_collide>false</self_collide>
            </collision>
        </link>

        <!-- ── Acrylic dome — own link so its visual has a clean, stable name
             (qupa/acrylic_dome_link_visual) that led_sim_node targets via
             material_color to make the dome GLOW in the LED colour (the
             "difuminado" look).  Nameless visual + disableFixedJointLumping →
             sdformat auto-names it <link>_visual.  Visual only. -->
        <link name="$(arg tf_prefix)/acrylic_dome_link">
            <inertial>
                <mass value="1e-5" />
                <origin xyz="0 0 0" rpy="0 0 0" />
                <inertia ixx="1e-9" ixy="0" ixz="0"
                         iyy="1e-9" iyz="0" izz="1e-9" />
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="package://qupa_description/meshes/dome.stl" scale="${base_scale}" />
                </geometry>
                <material name="acrylic" />
            </visual>
        </link>

        <joint name="acrylic_dome_joint" type="fixed">
            <parent link="$(arg tf_prefix)/base_link" />
            <child  link="$(arg tf_prefix)/acrylic_dome_link" />
            <origin xyz="0 0 0" rpy="0 0 0" />
        </joint>

        <gazebo reference="acrylic_dome_joint">
            <disableFixedJointLumping>true</disableFixedJointLumping>
            <preserveFixedJoint>true</preserveFixedJoint>
        </gazebo>

        <joint name="imu_joint" type="fixed">
            <parent link="$(arg tf_prefix)/base_link"/>
            <child link="$(arg tf_prefix)/imu_link"/>
            <origin xyz="0.0 0 0.07" rpy="0 0 0"/>
        </joint>

        <link name="$(arg tf_prefix)/imu_link">
            <inertial>
                <mass value="0.05"/>
                <inertia ixx="0.000001" ixy="0" ixz="0"
                        iyy="0.000001" iyz="0"
                        izz="0.000001"/>
            </inertial>
            <visual>
                <geometry>
                    <box size="0.01 0.01 0.01"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <box size="0.01 0.01 0.01"/>
                </geometry>
            </collision>
        </link>

    </xacro:macro>
</robot>